{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 52428800
    }
  },
  "ConnectionStrings": {
    "Default": "Host=192.168.100.104;Port=5432;Database=ecommerce;Username=ecommerce;Password=ecommerce"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": true
  },
  "ReverseProxy": {
    "Enabled": true
  },
  "Seed": {
    "DemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
