# Copy to .env and adjust for the target environment.
# The API reads standard ASP.NET Core configuration keys, where `__` means `:`.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=ecommerce;Username=ecommerce;Password=ecommerce
Database__AutoMigrate=true

# Local development uses the Vite-style dev proxy on :4200.
# Production is same-origin behind Caddy, so this can stay empty.
Cors__AllowedOrigins__0=http://localhost:4200

# Set to true only when the API sits behind a trusted local reverse proxy.
ReverseProxy__Enabled=false

# Demo seeding creates the demo storefront and known demo accounts.
# On a real deployment set DemoData=false and provide only the admin password
# once, to bootstrap the first admin, then remove the password from the file.
Seed__DemoData=true
Seed__AdminPassword=Admin123!
Seed__VendorPassword=Vendor123!

# Used by the SSR server at runtime (absolute origin, no trailing slash).
API_BASE_URL=http://localhost:5080

# Angular 22 only server-renders requests whose Host header is allow-listed.
# Use the public hostname(s) without scheme or port, comma-separated.
# NG_ALLOWED_HOSTS=bazaar.example.com
